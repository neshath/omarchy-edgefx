{
  "schemaVersion": 1,
  "id": "io.github.neshath.edgefx",
  "name": "EdgeFX",
  "version": "0.1.0",
  "description": "Animated, theme-aware screen-edge lighting for Omarchy.",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "EdgeFX",
    "description": "Toggle animated screen-edge effects.",
    "category": "Display",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "preset": "ambient",
      "accent": "#7aa2f7",
      "intensity": 0.32,
      "speed": 5
    },
    "schema": [
      { "key": "enabled", "type": "boolean", "label": "Enabled", "defaultValue": true },
      { "key": "preset", "type": "string", "label": "Preset", "defaultValue": "ambient", "description": "ambient, flow, pulse, or alert" },
      { "key": "accent", "type": "string", "label": "Accent color", "defaultValue": "#7aa2f7" },
      { "key": "intensity", "type": "number", "label": "Intensity", "min": 0.05, "max": 1, "step": 0.05, "defaultValue": 0.32 },
      { "key": "speed", "type": "integer", "label": "Speed", "min": 1, "max": 20, "step": 1, "defaultValue": 5 }
    ]
  }
}
