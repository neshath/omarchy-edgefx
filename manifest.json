{
  "schemaVersion": 1,
  "id": "io.github.neshath.edgefx",
  "name": "EdgeFX",
  "version": "0.1.0",
  "description": "Animated, theme-aware screen-edge lighting for Omarchy.",
  "kinds": ["bar-widget", "service"],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "EdgeFX",
    "description": "Toggle animated screen-edge effects.",
    "category": "Display",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "enabled": true,
      "preset": "sunset",
      "accent": "#7aa2f7",
      "intensity": 0.32,
      "speed": 5,
      "audioSync": false,
      "mediaMode": false,
      "dynamicColors": true,
      "bloom": 0.35
    },
    "schema": [
      { "key": "enabled", "type": "boolean", "label": "Enabled", "defaultValue": true },
      { "key": "preset", "type": "string", "label": "Scene", "defaultValue": "sunset", "description": "ambient, rainbow, sunset, ocean, aurora, fire, pulse, or alert" },
      { "key": "accent", "type": "string", "label": "Accent color", "defaultValue": "#7aa2f7" },
      { "key": "intensity", "type": "number", "label": "Intensity", "min": 0.05, "max": 1, "step": 0.05, "defaultValue": 0.32 },
      { "key": "speed", "type": "integer", "label": "Speed", "min": 1, "max": 20, "step": 1, "defaultValue": 5 },
      { "key": "audioSync", "type": "boolean", "label": "Audio sync", "defaultValue": false, "description": "Modulate edge brightness from the audio bridge." },
      { "key": "mediaMode", "type": "boolean", "label": "Media overlay", "defaultValue": false, "description": "Show album art, track metadata, lyrics, and clock." },
      { "key": "dynamicColors", "type": "boolean", "label": "Dynamic colors", "defaultValue": true, "description": "Shift the edge palette with the scene and audio level." },
      { "key": "bloom", "type": "number", "label": "Bloom intensity", "min": 0, "max": 1, "step": 0.05, "defaultValue": 0.35 }
    ]
  }
}
